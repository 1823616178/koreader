# AI Quota configuration. Edit over USB, then reopen the app.
# API endpoint: host, host:port, or full /api/usage URL. Optional per-request
# filter example: http://host:8787/api/usage?providers=grok,claude
api_url=http://123.161.179.32:46927/api/usage

# Touch calibration (0/1). Run `aiquota --calibrate` over SSH to determine.
touch_swap_xy=0
touch_mirror_x=0
touch_mirror_y=0

# Release WiFi after a fetch only when this app raised it (0/1).
wifi_auto_off=1

# Periodic refresh interval in minutes. 0 disables; valid range is 1..60.
# The app never exits on its own; between ticks it parks with the CPU idle,
# the radio off and the e-ink static. Cycles that fetch identical data with
# an unchanged battery badge skip the screen flash entirely.
auto_refresh_min=0
