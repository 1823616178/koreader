# AI Quota configuration. Edit over USB, then reopen the app.
# API endpoint: host, host:port, or full /api/usage URL.
api_url=http://123.161.179.32:46927/api/usage

# Touch calibration (0/1). Run `aiquota --calibrate` over SSH to determine.
touch_swap_xy=0
touch_mirror_x=0
touch_mirror_y=0

# Release WiFi after a fetch only when this app raised it (0/1).
wifi_auto_off=1

# Periodic refresh interval in minutes. 0 disables; valid range is 1..60.
auto_refresh_min=0

# F06: idle frontlight off after N minutes; 0 disables.
light_idle_off_min=3

# F04: 0=follow API displayMode, 1=used, 2=remain, 3=large, 4=compact
display_mode_pref=0

# F05: 0=custom (use auto_refresh_min), 1=manual, 2=normal(5), 3=night(30)
refresh_preset=0

# F02: local ordered provider visibility. Request uses ?providers=...
# Does NOT call PUT /api/providers. Default = all supported tools.
show_providers=grok,codex,kimi,agy

# F07 config schema version
config_version=2
